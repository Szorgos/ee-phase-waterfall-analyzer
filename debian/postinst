#!/bin/sh
set -e
# A felhasználói szolgáltatás (aqulify.service) a rendszer előbeállítása (80-aqulify.preset) szerint minden felhasználónál engedélyezett.
# A már futó motor frissítés után a következő bejelentkezéskor, vagy a „systemctl --user restart aqulify” parancsra indul újra.
if [ "$1" = "configure" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --global preset aqulify.service >/dev/null 2>&1 || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -d /usr/share/icons/hicolor ]; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
    fi
fi
exit 0
